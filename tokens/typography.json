{
  "font-family": {
    "sans": {
      "$value": "'Open Sans Variable', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
    },
    "mono": {
      "$value": "ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace"
    }
  },
  "font-weight": {
    "regular": {
      "$value": 400
    },
    "semibold": {
      "$value": 600
    },
    "bold": {
      "$value": 700
    }
  },
  "text-style": {
    "h1": {
      "mobile": {
        "size": {
          "$value": "3.5rem"
        },
        "line-height": {
          "$value": 1.3
        },
        "weight": {
          "$value": "{font-weight.bold}"
        }
      }
    },
    "h2": {
      "mobile": {
        "size": {
          "$value": "2.25rem"
        },
        "line-height": {
          "$value": 1.3
        },
        "weight": {
          "$value": "{font-weight.bold}"
        }
      }
    },
    "h3": {
      "mobile": {
        "size": {
          "$value": "1.25rem"
        },
        "line-height": {
          "$value": 1.3
        },
        "weight": {
          "$value": "{font-weight.bold}"
        }
      }
    },
    "title": {
      "mobile": {
        "size": {
          "$value": "1.25rem"
        },
        "line-height": {
          "$value": "normal"
        },
        "weight": {
          "$value": "{font-weight.bold}"
        }
      }
    },
    "body-lg": {
      "mobile": {
        "size": {
          "$value": "1rem"
        },
        "line-height": {
          "$value": 1.5
        },
        "weight": {
          "$value": "{font-weight.regular}"
        }
      }
    },
    "body-lg-semibold": {
      "mobile": {
        "size": {
          "$value": "1rem"
        },
        "line-height": {
          "$value": 1.5
        },
        "weight": {
          "$value": "{font-weight.semibold}"
        }
      }
    },
    "body-sm": {
      "mobile": {
        "size": {
          "$value": "0.875rem"
        },
        "line-height": {
          "$value": 1.5
        },
        "weight": {
          "$value": "{font-weight.regular}"
        }
      }
    },
    "body-sm-bold": {
      "mobile": {
        "size": {
          "$value": "0.875rem"
        },
        "line-height": {
          "$value": 1.5
        },
        "weight": {
          "$value": "{font-weight.bold}"
        }
      }
    },
    "meta": {
      "mobile": {
        "size": {
          "$value": "0.875rem"
        },
        "line-height": {
          "$value": "normal"
        },
        "weight": {
          "$value": "{font-weight.regular}"
        }
      }
    },
    "label": {
      "mobile": {
        "size": {
          "$value": "0.75rem"
        },
        "line-height": {
          "$value": "normal"
        },
        "weight": {
          "$value": "{font-weight.bold}"
        }
      }
    },
    "option": {
      "mobile": {
        "size": {
          "$value": "0.875rem"
        },
        "line-height": {
          "$value": "1.25rem"
        },
        "weight": {
          "$value": "{font-weight.regular}"
        }
      }
    },
    "option-semibold": {
      "mobile": {
        "size": {
          "$value": "0.875rem"
        },
        "line-height": {
          "$value": "1.25rem"
        },
        "weight": {
          "$value": "{font-weight.semibold}"
        }
      }
    },
    "caption": {
      "mobile": {
        "size": {
          "$value": "0.75rem"
        },
        "line-height": {
          "$value": 1.3
        },
        "weight": {
          "$value": "{font-weight.regular}"
        }
      }
    }
  }
}
